# Copy to .env and fill in real values. Never commit .env.

# Comma-separated pool of API keys, at least 2. Ids are key_1, key_2, ... in this order.
# (Gemini keys are free at https://aistudio.google.com/apikey)
LLM_API_KEYS=your-first-gemini-key,your-second-gemini-key

# LiteLLM model name used for every key
LLM_MODEL=gemini/gemini-2.5-flash

# SQLite location. In Docker it lives on the named volume mounted at /data.
DATABASE_URL=sqlite:////data/app.db

# Comma-separated CORS origins allowed to call the backend (your frontend URL(s))
ALLOWED_ORIGINS=http://localhost:3000

# "true" enables the X-Simulate-Failure test header (needed for the failover demo)
ENABLE_FAILURE_SIMULATION=true

# Seconds a cached response stays valid
CACHE_TTL_SECONDS=3600

# --- frontend (docker-compose) ---
# URL the browser uses to reach the backend
API_URL=http://localhost:8000
# --- frontend (Vercel/Netlify build) ---
# VITE_API_URL=https://your-backend.onrender.com
